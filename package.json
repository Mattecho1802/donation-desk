{
  "name": "donation-desk",
  "productName": "Donation Desk",
  "version": "0.1.0",
  "description": "Record in-person donations and issue receipts. Runs offline on one computer.",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "npm run pack:win && node build/make-installer.js",
    "pack:win": "electron-builder --win dir --x64"
  },
  "dependencies": {
    "fuse.js": "^7.5.0",
    "sql.js": "^1.17.0",
    "tabulator-tables": "^6.7.1"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "author": "Donation Desk",
  "build": {
    "appId": "org.donationdesk.app",
    "productName": "Donation Desk",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    },
    "publish": null
  }
}